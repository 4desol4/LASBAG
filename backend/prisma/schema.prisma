generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  APPLICANT
  PROFESSIONAL
  MDA_OFFICER
  ADMIN
  SUPER_ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  ACTION_REQUIRED
  RETURNED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum RequirementStatus {
  NOT_REQUIRED
  REQUIRED
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  ACTION_NEEDED
  REJECTED
  EXPIRED
}

enum TaskStatus {
  QUEUED
  IN_PROGRESS
  WAITING
  COMPLETED
  OVERDUE
  ESCALATED
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum StageKey {
  REQUIREMENTS
  SUBMISSION
  CLEARANCES
  PLANNING_PERMIT
  AUTHORIZATION
  INSPECTIONS
  COMPLETION
}

enum StageState {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model User {
  id            String               @id @default(uuid())
  email         String               @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          Role                 @default(APPLICANT)
  agencyId      String?
  agency        Agency?              @relation(fields: [agencyId], references: [id])
  professional  ProfessionalProfile?
  applications  Application[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([role])
  @@index([agencyId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProfessionalProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  profession     String
  registrationNo String?
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agency {
  id          String                  @id @default(uuid())
  code        String                  @unique
  name        String
  description String?
  officers    User[]
  tasks       AgencyTask[]
  definitions RequirementDefinition[]
}

model Application {
  id            String                   @id @default(uuid())
  reference     String                   @unique
  applicantId   String
  status        ApplicationStatus        @default(DRAFT)
  currentStage  StageKey                 @default(REQUIREMENTS)
  progress      Int                      @default(0)
  submittedAt   DateTime?
  completedAt   DateTime?
  applicant     User                     @relation(fields: [applicantId], references: [id])
  project       Project?
  stages        ApplicationStage[]
  requirements  ApplicationRequirement[]
  documents     Document[]
  tasks         AgencyTask[]
  events        ApplicationEvent[]
  conversations Conversation[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([applicantId])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
}

model Project {
  id               String      @id @default(uuid())
  applicationId    String      @unique
  title            String
  developmentType  String
  siteAddress      String
  floors           Int?
  isNewDevelopment Boolean     @default(true)
  answers          Json
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ApplicationStage {
  id            String      @id @default(uuid())
  applicationId String
  stage         StageKey
  state         StageState  @default(PENDING)
  startedAt     DateTime?
  completedAt   DateTime?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, stage])
}

model RequirementDefinition {
  id           String                   @id @default(uuid())
  code         String                   @unique
  name         String
  description  String
  agencyId     String
  mandatory    Boolean                  @default(true)
  documentType String?
  stage        StageKey
  slaHours     Int?
  agency       Agency                   @relation(fields: [agencyId], references: [id])
  rules        RequirementRule[]
  instances    ApplicationRequirement[]
}

model RequirementRule {
  id                      String                @id @default(uuid())
  requirementDefinitionId String
  condition               Json?
  active                  Boolean               @default(true)
  definition              RequirementDefinition @relation(fields: [requirementDefinitionId], references: [id], onDelete: Cascade)

  @@index([requirementDefinitionId])
}

model ApplicationRequirement {
  id            String                @id @default(uuid())
  applicationId String
  definitionId  String
  status        RequirementStatus     @default(REQUIRED)
  statusReason  String?
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  definition    RequirementDefinition @relation(fields: [definitionId], references: [id])
  documents     Document[]
  comments      Comment[]
  sla           SLA?
  updatedAt     DateTime              @updatedAt

  @@unique([applicationId, definitionId])
  @@index([status])
}

model Document {
  id            String                  @id @default(uuid())
  applicationId String
  requirementId String?
  documentType  String
  uploadedById  String
  application   Application             @relation(fields: [applicationId], references: [id])
  requirement   ApplicationRequirement? @relation(fields: [requirementId], references: [id])
  versions      DocumentVersion[]

  @@index([applicationId])
  @@index([requirementId])
  @@index([uploadedById])
}

/// Binary content lives here (BYTEA). Never select fileData in list queries.
model DocumentVersion {
  id              String         @id @default(uuid())
  documentId      String
  version         Int
  originalName    String
  mimeType        String
  fileSize        Int
  fileData        Bytes
  status          DocumentStatus @default(UPLOADED)
  rejectionReason String?
  uploadedById    String
  uploadedAt      DateTime       @default(now())
  verifiedAt      DateTime?
  document        Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

model AgencyTask {
  id            String      @id @default(uuid())
  applicationId String
  agencyId      String
  stage         StageKey
  title         String
  status        TaskStatus  @default(QUEUED)
  assigneeId    String?
  dependsOnId   String?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  agency        Agency      @relation(fields: [agencyId], references: [id])
  sla           SLA?

  @@index([agencyId, status])
  @@index([applicationId])
}

model SLA {
  id            String                  @id @default(uuid())
  taskId        String?                 @unique
  requirementId String?                 @unique
  startTime     DateTime
  dueTime       DateTime
  completedTime DateTime?
  task          AgencyTask?             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requirement   ApplicationRequirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model ApplicationEvent {
  id            String      @id @default(uuid())
  applicationId String
  actorId       String?
  actorRole     Role?
  type          String
  description   String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model Conversation {
  id            String      @id @default(uuid())
  applicationId String
  subject       String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages      Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String?
  isSystem       Boolean      @default(false)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Comment {
  id            String                 @id @default(uuid())
  requirementId String
  authorId      String
  body          String
  createdAt     DateTime               @default(now())
  requirement   ApplicationRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

/// Append-only. Grant the app DB role INSERT/SELECT only.
model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  role           Role?
  action         String
  entity         String
  entityId       String
  previousStatus String?
  newStatus      String?
  reason         String?
  ip             String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Integration {
  id      String             @id @default(uuid())
  code    String             @unique
  name    String
  enabled Boolean            @default(false)
  events  IntegrationEvent[]
}

model IntegrationEvent {
  id            String           @id @default(uuid())
  integrationId String
  type          String
  payload       Json
  createdAt     DateTime         @default(now())
  integration   Integration      @relation(fields: [integrationId], references: [id])
  logs          IntegrationLog[]
}

model IntegrationLog {
  id        String           @id @default(uuid())
  eventId   String
  outcome   String
  detail    String?
  createdAt DateTime         @default(now())
  event     IntegrationEvent @relation(fields: [eventId], references: [id])
}

model SystemSetting {
  key   String @id
  value Json
}
