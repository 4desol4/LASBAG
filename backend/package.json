{
  "name": "@lasbag/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma generate && prisma migrate dev",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "express": "^4.19.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0",
    "argon2": "^0.41.0",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.0",
    "cookie-parser": "^1.4.6",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0"
  }
}
